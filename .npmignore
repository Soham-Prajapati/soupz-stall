# Dependencies (users install their own)
node_modules/
packages/*/node_modules/

# Environment & secrets
.env
.env.local
.env.*.local
.env.example

# Development tools
_bmad/
benchmarks/
notes/
scripts/
design-artifacts/
gemini/
shubh/
skills/
tests/
supabase/

# Dashboard (built separately, not needed for CLI)
packages/dashboard/

# Git & CI
.git/
.gitignore
.github/
.gitlab-ci.yml

# Docs
# NOTE: this must stay anchored to the repo root. A bare `*.md` matches at every
# depth and silently strips all of defaults/agents/*.md — the agent personas that
# are the entire product — so a published install seeds zero agents.
docs/
defaults/agents/SKILL_ANALYSIS.md
defaults/agents/SKILL_TEMPLATE.md
/*.md
!/README.md

# Deployment / hosting configs
.vercel/
vercel.json
docker-compose.yml
Dockerfile

# Editor & IDE
.vscode/
.idea/
.DS_Store

# Build artifacts & logs
dist/
build/
.next/
*.log
npm-debug.log*
yarn-debug.log*
*.tgz
.cache/
coverage/

# Config files not needed at runtime
*.config.js
jest.config.js
generate_project_overview.cjs
pnpm-lock.yaml

# Other
.turbo
.npmrc
.yarnrc
.copilot.md
.gemini.md
hack_ps.md
.claude
.soupz-runs

# Runtime output — contains raw prompt text from every local run
.soupz/
_soupz_output/

# One-shot codemods; these rewrite bin/soupz.js and git-endpoints.js if run
refactor-bin.js
refactor-exec.js
bin/soupz_repl_patch.js

# Captured tunnel logs
pinggy_output.txt
