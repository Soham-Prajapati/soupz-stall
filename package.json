{
    "name": "soupz-cli",
    "version": "0.2.0",
    "description": "Code from anywhere — AI coding IDE that bridges your phone to your laptop",
    "type": "module",
    "bin": {
        "soupz-cli": "bin/soupz.js"
    },
    "workspaces": [
        "packages/*"
    ],
    "files": [
        "bin/soupz.js",
        "src/",
        "defaults/",
        "packages/remote-server/package.json",
        "packages/remote-server/src/",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "setup": "node --max-old-space-size=4096 scripts/setup.js",
        "start": "node --max-old-space-size=4096 bin/soupz.js",
        "dev": "node --max-old-space-size=4096 bin/soupz.js",
        "dev:web": "node --max-old-space-size=4096 scripts/dev-web-stack.js",
        "dev:web:pnpm": "SOUPZ_PM=pnpm node --max-old-space-size=4096 scripts/dev-web-stack.js",
        "dev:web:npm": "SOUPZ_PM=npm node --max-old-space-size=4096 scripts/dev-web-stack.js",
        "test": "vitest run",
        "smoke:cli": "node scripts/cli-smoke-check.mjs",
        "smoke:pairing": "node scripts/pairing-smoke-check.mjs",
        "snapshot:mobile": "node scripts/mobile-viewport-snapshots.mjs",
        "lint:docs-links": "node scripts/check-doc-links.mjs",
        "prepare": "node --max-old-space-size=4096 src/auto-import.js"
    },
    "devDependencies": {
        "vitest": "^3.2.4"
    },
    "optionalDependencies": {
        "node-pty": "^1.0.0"
    },
    "dependencies": {
        "@supabase/supabase-js": "^2.98.0",
        "chalk": "^5.3.0",
        "conf": "^13.0.1",
        "dotenv": "^17.3.1",
        "express": "^4.21.0",
        "figlet": "^1.8.0",
        "gradient-string": "^3.0.0",
        "meow": "^13.0.0",
        "puppeteer-core": "^24.37.5",
        "qrcode": "^1.5.4",
        "tree-kill": "^1.2.2",
        "ws": "^8.18.0",
        "yaml": "^2.6.1"
    },
    "engines": {
        "node": ">=18"
    },
    "keywords": [
        "ai",
        "ide",
        "cli",
        "remote-execution",
        "terminal",
        "agent",
        "copilot",
        "claude",
        "gemini"
    ],
    "author": "Shubh Prajapati",
    "license": "MIT"
}
